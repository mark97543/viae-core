{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-app",
  "version": "0.1.0",
  "identifier": "com.mark.desktop-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Iter Viae - The Way Of The Road",
        "width": 800,
        "height": 600,
        "minWidth": 750,
        "minHeight": 550
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/tilemaker"
    ],
    "resources": [
      "resources/config-openmaptiles.json",
      "resources/process-openmaptiles.lua"
    ]
  }
}